# Supabase project (database + auth + storage)
# Create a project at https://supabase.com and copy these from Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only: used for service-role operations (admin actions, storage uploads)
# NEVER expose this to the browser (no VITE_ prefix)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
SUPABASE_ANON_KEY=YOUR-ANON-KEY

PORT=8787
# Extra CORS origins, comma-separated. Production (diamondthrivelogistics.com),
# localhost/127.0.0.1 (any port) and *.vercel.app previews are already allowed.
CLIENT_ORIGIN=http://localhost:5173

# Public API base URL used by the frontend. Local development defaults to /api.
VITE_API_BASE_URL=/api

